{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": true,
    "noImplicitAny": true,
    "lib": ["ES2020", "DOM"],
    "baseUrl": "."
  },
  "include": [
    "packages/**/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
